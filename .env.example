# Credential infra + biến runtime cho docker-compose.yml. Tạo .env bằng env-check, không commit .env.
APP_ENV=development
LOG_LEVEL=info

# --- db (postgres:18-alpine) ---
POSTGRES_USER=ticket
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ticket

# --- api ---
# password: POSTGRES_PASSWORD
DATABASE_URL=postgres://ticket:changeme@db:5432/ticket
# bên thứ ba: VNPay sandbox, mã website (TmnCode) trong email đăng ký sandbox
VNPAY_TMN_CODE=
# bên thứ ba: VNPay sandbox, chuỗi bí mật (HashSecret) trong email đăng ký sandbox
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL_BASE=http://localhost:3000/don-hang

# --- web ---
SITE_URL=http://localhost:3000
# Base URL của api trong mạng compose, gồm prefix /api
API_INTERNAL_URL=http://api:8080/api

# --- tunnel (profile `tunnel`, tuỳ chọn: nhận IPN của VNPay về máy local) ---
# bên thứ ba: ngrok authtoken (dashboard.ngrok.com)
NGROK_AUTHTOKEN=
# bên thứ ba: ngrok dev domain cố định, vd abc-123.ngrok-free.app (không kèm https://)
NGROK_DOMAIN=
