{
  "name": "ticket-api",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,test}/**/*.{ts,json}\" \"*.{ts,js,json}\""
  },
  "packageManager": "pnpm@10.34.6",
  "type": "module",
  "private": true,
  "dependencies": {
    "@fastify/helmet": "^13.1.2",
    "croner": "^10.0.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "~0.29.6",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
