# Runtime env (server-side, không NEXT_PUBLIC_) — đọc lúc request, không nướng vào image
# Base URL của api trong mạng compose (gồm prefix /api)
API_INTERNAL_URL=http://api:8080/api
# URL public của web (robots, URL tuyệt đối)
SITE_URL=http://localhost:3000
# development | production (production bật HSTS + cookie Secure)
APP_ENV=development
